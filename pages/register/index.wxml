<t-message id="t-message" />
<view class="container">
  <view style="padding-top: 10%;">
    <t-navbar title="用户注册" left-arrow bind:go-back="handleBack" />
    <form bind:submit="formSubmit" style="padding-top: 30rpx;">
      <t-input name="username" bind:change="onUsernameInput" class="custom-class" label="用户名" status="{{!hasUsername ? 'error' : 'default'}}" tips="{{!hasUsername ? '请输入用户名' : ''}}" placeholder="请输入用户名" type="text" clearable="{{ true }}" />
      <t-input name="account" bind:change="onAccountInput" class="custom-class" label="账号" status="{{!hasAccount ? 'error' : 'default'}}" tips="{{!hasAccount ? '请输入账号' : ''}}" placeholder="请输入账号" type="text" clearable="{{ true }}" />
      <t-input name="password" bind:change="onPasswordInput" class="custom-class" label="密码" status="{{!hasPassword ? 'error' : 'default'}}" tips="{{!hasPassword ? '请输入密码' : ''}}" placeholder="请输入密码" type="{{passwordInputType}}" clearable="{{ true }}" suffixIcon="{{ { name: passwordIconName } }}" bind:click="onSuffixIconClick" />
      <t-input name="confirmPassword" bind:change="onConfirmPasswordInput" class="custom-class" label="确认密码" status="{{(!hasConfirmPassword||!isTwoPasswordSame) ? 'error' : 'default'}}" tips="{{!hasConfirmPassword ? '请再次输入密码' : !isTwoPasswordSame?'两次输入密码不一致':''}}" placeholder="请再次输入密码" type="{{confirmPasswordInputType}}" clearable="{{ true }}" suffixIcon="{{ { name: confirmPasswordIconName } }}" bind:click="onConfirmSuffixIconClick" />
      <view style="padding-top: 30rpx; width: 100%; display: flex; justify-content: center; ">
        <view style="width: 500rpx;">
          <t-button type="submit" theme="primary" size="small" block>提交</t-button>
        </view>
      </view>
    </form>
  </view>

</view>